# Copy this file to .env  (cp .env.example .env)

# Which Gemma 4 model the game and Open WebUI use.
#   gemma4:e4b-it-qat  6.1 GB  default, fine on a 16 GB Mac
#   gemma4:e2b-it-qat  4.3 GB  faster, less accurate
#   gemma4:12b-mlx     7.7 GB  better quality, only with Ollama running natively on a Mac
GEMMA_MODEL=gemma4:e4b-it-qat

# Where the Gemma API lives.
#   MODE B (everything in Docker):         http://ollama:11434
#   MODE A (Ollama app running on the Mac): http://host.docker.internal:11434
OLLAMA_URL=http://ollama:11434
